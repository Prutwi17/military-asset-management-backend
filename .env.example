# Database Environment Configuration (Placeholders only - set in Render Environment Variables)
DB_URL=jdbc:mysql://your-free-db-host:3306/military_db?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Server Port (Render sets PORT automatically)
PORT=8080

# JWT Security Key (At least 256-bit secret string for HMAC-SHA256)
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long_for_hmac_sha256
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of your Vercel domains and local dev)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# JPA Hibernate Schema Management (safe production update)
JPA_DDL_AUTO=update
